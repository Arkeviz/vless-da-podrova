{
  "name": "vless-da-podrova",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "dev:chrome": "pnpm --filter @vdp/extension dev",
